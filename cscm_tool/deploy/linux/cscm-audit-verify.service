[Unit]
Description=CSCM Tool audit-log hash chain verification (I-18)
After=cscm.service

[Service]
Type=oneshot
User=cscm
Group=cscm
WorkingDirectory=/opt/cscm/app
EnvironmentFile=/etc/cscm/cscm.env
# Non-zero exit when the chain is broken or the log is shorter than at the previous run.
ExecStart=/opt/cscm/venv/bin/flask audit-verify
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/cscm /var/log/cscm
