[Unit]
Description=CSCM Tool verified database backup (I-09)
After=cscm.service

[Service]
Type=oneshot
User=cscm
Group=cscm
WorkingDirectory=/opt/cscm/app
EnvironmentFile=/etc/cscm/cscm.env
# Non-zero exit when the new backup fails its restore check, so the unit shows as failed.
ExecStart=/opt/cscm/venv/bin/flask backup-db --keep 35
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/cscm /var/backups/cscm /var/log/cscm
