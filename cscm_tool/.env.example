# Copy to .env (development) or /etc/cscm/cscm.env, C:\CSCM\config\cscm.env (production).
# Every value is optional unless marked REQUIRED. docs/14-deployment-architecture.md section 4.
FLASK_APP=wsgi.py
FLASK_ENV=development

# REQUIRED in production: 32+ random characters (the app refuses to start without it).
SECRET_KEY=change-me-in-every-real-environment
# The default is instance/cscm.db inside the application directory (created on the first
# `flask db upgrade`). Set a path only to put the database elsewhere; use an absolute one.
# DATABASE_URL=sqlite:///instance/cscm.db

# Where attachments, import files and the audit anchor live (default: ./instance).
# CSCM_INSTANCE_PATH=/var/lib/cscm/instance

# Web server (scripts/serve.py)
# CSCM_HOST=127.0.0.1
# CSCM_PORT=8000
# CSCM_THREADS=8
# CSCM_TRUSTED_PROXY=127.0.0.1

# Integrity keys: recommended in production. Changing one later invalidates what it signed.
# MANIFEST_SIGNING_KEY=
# AUDIT_HMAC_KEY=

# Backups (flask backup-db) and monitoring
# BACKUP_DIR=/var/backups/cscm
# BACKUP_MAX_AGE_HOURS=36
# LOG_FILE=/var/log/cscm/cscm.log
# METRICS_ALLOWED_CIDRS=127.0.0.0/8,10.0.0.0/8
# METRICS_TOKEN=

# Optional mail through the organisation's own relay (in-app notices work without it)
# SMTP_HOST=
# SMTP_PORT=25
# SMTP_SENDER=cscm-tool@example.internal
# SMTP_STARTTLS=0
# SMTP_USERNAME=
# SMTP_PASSWORD=

# Uploads above this many rows are imported by a background worker
# IMPORT_ASYNC_ROW_THRESHOLD=300

# How people sign in: password (default), windows or both (docs/11-security-architecture.md SEC-033).
# With windows the password form is refused and the gateway in front of the application supplies the
# signed-in Windows user in a header; it is believed only from the addresses listed as trusted.
# AUTH_MODE=password
# WINDOWS_AUTH_HEADER=X-Remote-User
# WINDOWS_AUTH_TRUSTED_PROXIES=10.0.0.5
# WINDOWS_AUTH_EMAIL_DOMAIN=corp.example
# (WINDOWS_AUTH_SIMULATE exists for developer machines only; production refuses to start with it.)

